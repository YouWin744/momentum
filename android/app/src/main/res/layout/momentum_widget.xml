<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/momentum_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/momentum_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/momentum_widget_title_action"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:clickable="true"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:text="@string/momentum_widget_title"
            android:textColor="#FF2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/momentum_widget_count"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:textColor="#FF64748B"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="3dp"
        android:background="#664CAF50" />

    <ListView
        android:id="@+id/momentum_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/momentum_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="42dp"
        android:text="@string/momentum_widget_empty"
        android:textColor="#FF64748B"
        android:textSize="14sp" />
</LinearLayout>
